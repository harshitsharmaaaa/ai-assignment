{
  "name": "@leadflow/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@leadflow/eslint-config": "workspace:*",
    "@leadflow/tsconfig": "workspace:*",
    "eslint": "^9.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0"
  }
}
