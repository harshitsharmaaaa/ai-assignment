# Postgres (used by docker-compose.yml)
POSTGRES_USER=leadflow # db superuser for local dev
POSTGRES_PASSWORD=leadflow_dev_pw # safe placeholder only — change for real use
POSTGRES_DB=leadflow # database name

# App (single root .env is source of truth)
DATABASE_URL=postgresql://leadflow:leadflow_dev_pw@localhost:5432/leadflow # prisma + backend connection string
PORT=4000 # backend listen port
WEB_ORIGIN=http://localhost:3000 # backend CORS allowlist (frontend origin)
NODE_ENV=development # development | production (controls stack-trace leaking)
NEXT_PUBLIC_API_URL=http://localhost:4000 # frontend -> backend base url
